# --- 1. FASE DE CONSTRUÇÃO (Build Stage) ---
FROM python:3.11-alpine AS builder

# Define o diretório de trabalho para a construção
WORKDIR /build

# Dependências de compilação para Alpine
RUN apk add --no-cache \
    gcc \
    g++ \
    musl-dev \
    linux-headers \
    libffi-dev \
    openssl-dev \
    make

# Copia o requirements.txt
COPY app/users/requirements.txt .

# Instala as dependências de forma segura e limpa (sem cache)
RUN pip install --upgrade pip>=25.2 && \
    pip install --no-cache-dir "jaraco.context>=6.1.0" && \
    pip install --no-cache-dir -r requirements.txt

## 1. Instalar Safety e criar pasta de relatórios
RUN pip install --no-cache-dir --break-system-packages safety 

## 2. Criar a pasta E gerar o relatório num único passo seguro
RUN mkdir -p /reports/docker && \
    safety check -r requirements.txt --full-report > /reports/docker/safety-report.txt || \
    (echo "⚠️ Safety encontrou vulnerabilidades" && cat /reports/docker/safety-report.txt)

# 3. Instalação das dependências (Target isolado)
RUN mkdir -p /app/dependencies && \
    pip install --no-cache-dir --target=/app/dependencies -r requirements.txt

# --- 2. FASE FINAL (Runtime Stage) ---
FROM python:3.11-alpine AS stage-1    

# Instala ferramentas como curl, netcat-openbsd  e adduser no Alpine
RUN apk update && apk upgrade && \
    apk add --no-cache \
    curl \
    netcat-openbsd \
    bash \
    libstdc++ \
    && pip install --no-cache-dir --upgrade pip>=25.2 \
    && adduser -D -g "" appuser

# Define variáveis de ambiente
ENV PYTHONUNBUFFERED=1
ENV APP_HOME=/app
ENV PORT=5000

# Variáveis para OpenTelemetry
ENV OTEL_SERVICE_NAME=users-service
ENV OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# PYTHONPATH: /app é necessário para encontrar o módulo 'shared'
ENV PYTHONPATH=${APP_HOME}

WORKDIR ${APP_HOME}

# Copia as dependências instaladas na fase de construção
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /reports/docker/safety-report.txt /reports/docker/safety-report.txt

# --- [BLINDAGEM TRIVY] ---
# O pip pode deixar metadados da versão antiga (5.3.0) que enganam o scanner.
# Como estamos em stage-1 (slim), limpamos qualquer rasto antes de mudar para o utilizador final.
USER root
RUN find /usr/local/lib/python3.11/site-packages -name "*jaraco.context-5.3.0*" -exec rm -rf {} + || true
# -------------------------

# Copia a pasta 'shared' e 'app' (incluindo app/users)
COPY app/shared ${APP_HOME}/shared
COPY app ${APP_HOME}/app
# Copia ficheiros de configuração de teste (CRÍTICO para o Test Runner partilhar)
COPY tests ${APP_HOME}/tests
COPY pytest.ini .
COPY app/shared/wait-for-it.sh /usr/local/bin/wait-for-it.sh

# Limpeza do comando e união de permissões
RUN chmod +x /usr/local/bin/wait-for-it.sh && \
    chown -R appuser:appuser ${APP_HOME}

# Expõe a porta
EXPOSE 5000

# Troca para o utilizador não-root para execução
USER appuser

# Comando para iniciar a aplicação Uvicorn
CMD ["sh", "-c", "/usr/local/bin/wait-for-it.sh otel-collector:4317 -- gunicorn -w 4 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:5000 app.users.users:app"]